# Copy this file to `.env` inside the `ML` directory and fill in the values.
# These variables are loaded by `ML/unified_api_server.py` and `ML/Llama/app.py`.

# -----------------------------------------------------------------------------
# Required: AWS Bedrock credentials
# -----------------------------------------------------------------------------
# Region where your Bedrock tenant lives (e.g. us-east-1, ap-south-1)
AWS_REGION=
# IAM access key with permission to call Bedrock `invoke_model`
AWS_ACCESS_KEY=
# IAM secret key paired with the access key above
AWS_SECRET_KEY=
# The Bedrock inference profile ARN you want to use for Claude
INFERENCE_PROFILE_ARN=

# -----------------------------------------------------------------------------
# Optional: Groq API key (only needed if you plan to run ML/Llama/app.py
# with Groq as the primary LLM). Leave blank to disable Groq.
# -----------------------------------------------------------------------------
GROQ_API_KEY=

# -----------------------------------------------------------------------------
# Optional: Any additional provider keys can be added below as needed.
# -----------------------------------------------------------------------------






